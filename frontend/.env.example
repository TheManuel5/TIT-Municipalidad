# Configuración de Entorno - Frontend Inventario San Pablo
# Copiar este archivo como frontend/.env (frontend/.env NO se sube al repositorio)

# Fuente de datos:
#   true  -> datos simulados en el navegador (api.mock.js), no requiere backend
#   false -> API real Express + SQLite (requiere backend corriendo)
VITE_USE_MOCK=true

# URL base del Backend Express (cuando VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:3000/api

# Herramientas de demostración: selector "Simular rol", acceso rápido y credenciales
# precargadas en el login. Poner en false para un despliegue real en la municipalidad.
VITE_MODO_DEMO=true
