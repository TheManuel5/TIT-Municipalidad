# Configuración del backend - copiar como backend/.env (nunca subir backend/.env al repositorio)

PORT=3000
NODE_ENV=development

# Clave para firmar los tokens JWT. OBLIGATORIA en producción, mínimo 32 caracteres.
# Generar una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si no se define en desarrollo, se usa una aleatoria temporal (las sesiones se cierran al reiniciar).
JWT_SECRET=

# Orígenes del frontend autorizados por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Poner en true solo si la API está detrás de un proxy inverso (nginx) para registrar la IP real
TRUST_PROXY=false

# Límite de intentos fallidos de inicio de sesión por IP
LOGIN_MAX_INTENTOS=10
LOGIN_VENTANA_MINUTOS=15

# Zona horaria para cálculos de fechas (alertas, mantenciones)
APP_TZ=America/Santiago

# Respaldos automáticos de la base (db/backups/ por defecto)
BACKUP_AUTO=true
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENCION=14
# BACKUP_DIR=
# Si se define, los respaldos se cifran con AES-256-GCM. GUARDE LA CLAVE EN UN LUGAR SEGURO:
# sin ella no se puede restaurar.
# BACKUP_CLAVE=
